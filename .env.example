PORT=4000
NODE_ENV=development

JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_VALUE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=YOUR_DATABASE_NAME
DB_SSL=false

IMAGE_UPLOAD_DIR=/absolute/path/outside/the/deployment/product-images

# Keep false for a trade-only deployment. Enable only if retail registration is intentional.
ALLOW_PUBLIC_REGISTRATION=false
# Default trusts no proxy. Set the verified hop count and restrict direct API access.
TRUST_PROXY=0

# One-time db:create-admin/db:fresh inputs. Never commit real values.
ADMIN_NAME=YOUR_ADMIN_NAME
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=SET_AT_RUNTIME_AND_REMOVE_AFTER_USE

# db:seed requires NODE_ENV=development or test and a runtime-only password.
# SEED_PASSWORD=
